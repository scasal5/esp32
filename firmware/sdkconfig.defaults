CONFIG_IDF_TARGET="esp32s3"

# --- CPU a 240 MHz. El default del ESP32-S3 es 160; el firmware de fabrica
#     corre a 240 y no hay razon para dejar rendimiento sin usar. ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Flash: 16 MB. La de fabrica corre QIO 80 MHz en runtime. ---
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- Tabla de particiones propia ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/default.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- PSRAM octal 8 MB @ 80 MHz (AP Memory 3V3, verificado en el boot log) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- Consola por USB-Serial-JTAG ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# --- Sin light sleep.
#
#     Con PM_ENABLE apagado no hay light sleep automatico, asi que el
#     aislamiento de GPIO nunca llega a ejecutarse y el USB-Serial-JTAG no se
#     duerme. Eso es lo que evita el COM zombie que daba el firmware de fabrica.
#
#     Nota: la linea "sleep_gpio: Configure to isolate all GPIO pins in sleep
#     state" IGUAL aparece en el boot log. La emite CONFIG_PM_SLP_DISABLE_GPIO,
#     que sigue en 'y' y solo deja preparada la configuracion por si hubiera un
#     sleep. Sin PM no se dispara. Es esperado, no es el bug de fabrica. ---
# CONFIG_PM_ENABLE is not set
# CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP is not set

CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- BSP ---
# El BSP monta SPIFFS por label y su default es "storage". Nuestra tabla
# llama a esa particion "assets", asi que hay que decirselo o falla el mount.
CONFIG_BSP_SPIFFS_PARTITION_LABEL="assets"

# --- LVGL ---
# Malloc de C en vez del pool propio de LVGL (64 KB fijos): el objeto lv_gif
# (~24 KB) y su framebuffer ARGB8888 (hasta 272 KB) no entran en el pool. Con
# CONFIG_SPIRAM_USE_MALLOC, los pedidos grandes se sirven desde PSRAM.
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
# Widget lv_gif, para la imagen de inicio (docs/arquitectura.md).
CONFIG_LV_USE_GIF=y
# PNG subido desde Fondo (canvas del celular).
CONFIG_LV_USE_LODEPNG=y
# QR para el SoftAP de provision (WIFI:T:nopass;S:ws183-xxxx;;).
CONFIG_LV_USE_QRCODE=y
# Un solo draw unit, a proposito. Probado con dos (CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# mas CONFIG_LV_OS_FREERTOS, que LVGL exige para repartir el trabajo): 105/110/110
# ms por frame contra 105/110/110 con uno. Cero diferencia. El cuello del fondo
# animado no son ciclos de CPU sino el ancho de banda de PSRAM, y dos cores
# leyendo la misma PSRAM no leen mas rapido.
CONFIG_LV_USE_LOG=y
CONFIG_LV_COLOR_DEPTH_16=y
# Sin esto no linkea lv_font_montserrat_20 (por defecto solo viene la 14).
CONFIG_LV_FONT_MONTSERRAT_20=y
# Hora de la pantalla de inicio.
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_14=y
